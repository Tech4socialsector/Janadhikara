  },
  {
   "fieldname": "entitlements",
   "fieldtype": "Table",
   "label": "Entitlements",
   "options": "Entitlement",
   "depends_on": "eval:doc.consent_given && !doc.consent_withdrawn_on"
  },
  {
   "fieldname": "documents",
   "fieldtype": "Table",
   "label": "Documents",
   "options": "Individual Document",
   "depends_on": "eval:doc.consent_given && !doc.consent_withdrawn_on"
  }
